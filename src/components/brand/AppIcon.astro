---
import type { HTMLAttributes } from "astro/types";
import type { IconName } from "../../content/site";

interface Props extends HTMLAttributes<"svg"> {
  name: IconName;
  size?: number;
}

const { name, size = 24, class: className, ...attrs } = Astro.props;
---

<svg
  class={className}
  aria-hidden="true"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...attrs}
>
  {
    name === "waveform" && (
      <>
        <path d="M3 12h2l2-6 3 12 3-15 3 16 2-7h3" />
        <path d="M3 20h18" opacity=".35" />
      </>
    )
  }
  {
    name === "playback" && (
      <>
        <path d="M8 5v14l11-7-11-7Z" />
        <path d="M4 5v14" />
      </>
    )
  }
  {
    name === "module" && (
      <>
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <path d="M7 8h3M14 8h3M7 12h10M7 16h6" />
      </>
    )
  }
  {
    name === "equalizer" && (
      <>
        <path d="M4 5v14M12 5v14M20 5v14" />
        <path d="M2 9h4M10 15h4M18 11h4" />
      </>
    )
  }
  {
    name === "playlist" && (
      <>
        <path d="M4 6h10M4 11h10M4 16h7" />
        <path d="M17 14v6M17 14l4-1v5" />
      </>
    )
  }
  {
    name === "download" && (
      <>
        <path d="M12 3v12M7 10l5 5 5-5" />
        <path d="M4 19h16" />
      </>
    )
  }
  {
    name === "convert" && (
      <>
        <path d="M5 7h13l-3-3M19 17H6l3 3" />
        <path d="m18 7 1-1-1-1M6 17l-1 1 1 1" />
      </>
    )
  }
  {
    name === "tag" && (
      <>
        <path d="M4 4h7l9 9-7 7-9-9V4Z" />
        <circle cx="8" cy="8" r="1" />
      </>
    )
  }
  {
    name === "library" && (
      <>
        <path d="M4 5h4v14H4zM10 5h4v14h-4zM16 7l3-1 3 12-4 1-2-12Z" />
      </>
    )
  }
  {
    name === "desktop" && (
      <>
        <rect x="3" y="4" width="18" height="13" rx="2" />
        <path d="M8 21h8M12 17v4" />
      </>
    )
  }
  {
    name === "appearance" && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </>
    )
  }
  {
    name === "language" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3c2.5 2.5 3.5 5.5 3.5 9S14.5 18.5 12 21M12 3C9.5 5.5 8.5 8.5 8.5 12s1 6.5 3.5 9" />
      </>
    )
  }
</svg>
