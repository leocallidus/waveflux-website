---
import { features } from "../../content/site";
import type { Dictionary } from "../../i18n";
import AppIcon from "../brand/AppIcon.astro";
import Container from "../layout/Container.astro";
import SectionHeading from "../layout/SectionHeading.astro";
import Card from "../ui/Card.astro";

interface Props {
  dictionary: Dictionary;
}

const { dictionary: t } = Astro.props;
---

<section
  id="features"
  class="wf-section border-y border-line/60 bg-surface-sunken/45"
  aria-labelledby="features-title"
>
  <Container>
    <SectionHeading
      eyebrow={t.features.eyebrow}
      title={t.features.title}
      description={t.features.description}
      titleId="features-title"
    />

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => {
          const item = t.features.items[feature.id];
          return (
            <Card class="h-full">
              <div class="wf-feature-icon">
                <AppIcon name={feature.icon} />
              </div>
              <h3 class="mt-4 text-lg">{item.title}</h3>
              <p class="wf-copy mt-2">{item.description}</p>
            </Card>
          );
        })
      }
    </div>
  </Container>
</section>

<style>
  .wf-feature-icon {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid rgb(var(--color-accent) / 0.32);
    border-radius: 8px;
    background: rgb(var(--color-accent) / 0.08);
    color: rgb(var(--color-accent));
  }
</style>
