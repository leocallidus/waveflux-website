---
import "../styles/global.css";
import type { Locale } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
  bodyClass?: string;
  canonicalPath?: "/" | "/ru/";
  image?: string;
}

const {
  title = "WaveFlux",
  description = "WaveFlux desktop audio player.",
  lang = "en",
  bodyClass = "",
  canonicalPath = "/",
  image = `${import.meta.env.BASE_URL}favicon.svg`,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://leocallidus.github.io");
const normalizedBase = import.meta.env.BASE_URL.replace(/\/$/, "");
const normalizedCanonicalPath =
  canonicalPath === "/" ? "/" : `/${canonicalPath.replace(/^\/|\/$/g, "")}/`;
const canonicalUrl = new URL(
  `${normalizedBase}${normalizedCanonicalPath}`,
  siteUrl,
).toString();
const enUrl = new URL(`${normalizedBase}/`, siteUrl).toString();
const ruUrl = new URL(`${normalizedBase}/ru/`, siteUrl).toString();
const imageUrl = new URL(image, canonicalUrl).toString();
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08131d" />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WaveFlux" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="WaveFlux desktop audio player" />
    <meta property="og:locale" content={lang === "ru" ? "ru_RU" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={lang === "ru" ? "en_US" : "ru_RU"}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ru" href={ruUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem("waveflux-theme");
        const theme = storedTheme === "light" ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
    <script is:inline>
      (() => {
        const storageKey = "waveflux-theme";

        const updateButtons = (theme) => {
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            const nextTheme = theme === "dark" ? "light" : "dark";
            const label =
              nextTheme === "dark"
                ? button.dataset.themeDark
                : button.dataset.themeLight;
            const text = button.querySelector("[data-theme-toggle-text]");

            button.setAttribute("aria-pressed", String(theme === "light"));
            if (text && label) text.textContent = label;
          });
        };

        const setTheme = (theme) => {
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
          localStorage.setItem(storageKey, theme);
          updateButtons(theme);
        };

        const initializeThemeControls = () => {
          const theme =
            document.documentElement.dataset.theme === "light"
              ? "light"
              : "dark";
          updateButtons(theme);

          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            if (button.dataset.themeBound === "true") return;
            button.dataset.themeBound = "true";
            button.addEventListener("click", () => {
              const current =
                document.documentElement.dataset.theme === "light"
                  ? "light"
                  : "dark";
              setTheme(current === "dark" ? "light" : "dark");
            });
          });
        };

        initializeThemeControls();
        document.addEventListener("astro:page-load", initializeThemeControls);
      })();
    </script>
  </body>
</html>
